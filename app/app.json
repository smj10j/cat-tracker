{
  "expo": {
    "name": "Whisker Health",
    "slug": "whisker-health",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "whiskerhealth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16111f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.01j.whisker",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:cat-tracker.pages.dev"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Whisker Health needs camera access to take photos of your cats.",
        "NSPhotoLibraryUsageDescription": "Whisker Health needs photo library access to select photos of your cats.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "UR8VJZL4LG"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16111f"
      },
      "package": "me.o1j.whisker"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c084fc"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-screen-orientation"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c62ccdf4-92f5-45fc-80e6-4cf56be6607b"
      }
    },
    "owner": "smj10j"
  }
}
