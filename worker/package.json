{
  "name": "cat-tracker-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute cat-tracker-db --local --file=src/db/schema.sql",
